# Copia este archivo a `.env` y rellena los valores.
# `.env` está ignorado por git: nunca lo subas.

# Obligatorio. Token del bot (Discord Developer Portal -> tu app -> Bot).
DISCORD_TOKEN=

# Opcional. Activa los comandos con prefijo, por ejemplo `!blackjack 100`.
# Requiere tener activado el intent privilegiado MESSAGE_CONTENT.
# DISCORD_PREFIX=!

# Opcional. Registra los comandos en un servidor concreto para que aparezcan
# al instante (los comandos globales pueden tardar hasta una hora).
# DISCORD_GUILD_ID=123456789012345678
